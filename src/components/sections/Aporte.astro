---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Capas del primer visual: etiqueta de área + tecnologías (las mismas del texto de la tarjeta)
const layers = [
  { area: t('skills.group.frontend'), stack: 'Next.js · React', tone: 'cyan' },
  { area: 'API', stack: 'NestJS · Express', tone: 'indigo' },
  { area: lang === 'es' ? 'Datos' : 'Data', stack: 'PostgreSQL · MongoDB', tone: 'emerald' },
];

const checks = ['JWT', 'Guards', 'Roles'];
---

<div>
  <h2 class="mb-6 text-3xl font-semibold text-white">{t('value.eyebrow')}</h2>

  <ul class="grid grid-cols-1 gap-5 md:grid-cols-3" data-pause-offscreen>
    <!-- 1. Producto completo: capas que flotan y se separan al pasar el cursor -->
    <li class="value-card" data-tilt>
      <div class="value-visual layers" aria-hidden="true">
        {layers.map((layer, i) => (
          <div class={`layer layer-${layer.tone}`} style={`--i:${i}`}>
            <span class="whitespace-nowrap text-[11px] uppercase tracking-wider opacity-70">{layer.area}</span>
            <span class="whitespace-nowrap text-xs font-medium">{layer.stack}</span>
          </div>
        ))}
      </div>
      <h3 class="value-title">{t('value.1.title')}</h3>
      <p class="value-text">{t('value.1.text')}</p>
    </li>

    <!-- 2. Pagos: un pulso recorre carrito → pago → validación -->
    <li class="value-card" data-tilt>
      <div class="value-visual flow" aria-hidden="true">
        <div class="flow-line"><div class="flow-track"><div class="flow-slide"><span class="flow-dot"></span></div></div></div>
        <div class="flow-node" style="--d:0s">
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M3 4h2.5l2.2 10.2a1 1 0 0 0 1 .8h8.6a1 1 0 0 0 1-.8L20 8H6.2"/></svg>
          <span>{t('value.v2.cart')}</span>
        </div>
        <div class="flow-node" style="--d:1.3s">
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3 10h18M7 15h3"/></svg>
          <span>{t('value.v2.pay')}</span>
        </div>
        <div class="flow-node" style="--d:2.6s">
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16 9.5"/></svg>
          <span>Webhook</span>
        </div>
      </div>
      <h3 class="value-title">{t('value.2.title')}</h3>
      <p class="value-text">{t('value.2.text')}</p>
    </li>

    <!-- 3. Seguridad: las comprobaciones aparecen una a una en bucle -->
    <li class="value-card" data-tilt>
      <div class="value-visual vault" aria-hidden="true">
        <div class="vault-head">
          <svg viewBox="0 0 24 24" class="size-5 text-cyan-300" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
          <span class="text-xs text-gray-400">/admin</span>
        </div>
        {checks.map((name, i) => (
          <div class="vault-row" style={`--i:${i}`}>
            <svg viewBox="0 0 24 24" class="vault-check size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
            <span class="text-sm">{name}</span>
          </div>
        ))}
      </div>
      <h3 class="value-title">{t('value.3.title')}</h3>
      <p class="value-text">{t('value.3.text')}</p>
    </li>
  </ul>
</div>

<script>
  // Foco de luz que sigue al cursor + inclinación muy leve (solo con ratón y sin "reducir movimiento")
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
    if (!canHover) return;
    let frame = 0;
    let x = 0;
    let y = 0;

    const paint = () => {
      frame = 0;
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${x}px`);
      card.style.setProperty('--my', `${y}px`);
      if (!reduce) {
        const rx = (0.5 - y / r.height) * 5;
        const ry = (x / r.width - 0.5) * 5;
        card.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-3px)`;
      }
    };

    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      x = e.clientX - r.left;
      y = e.clientY - r.top;
      card.classList.add('tracking');
      if (!frame) frame = requestAnimationFrame(paint);
    });

    card.addEventListener('pointerleave', () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      card.classList.remove('tracking');
      card.style.transform = '';
    });
  });
</script>

<style>
  .value-card {
    --mx: 50%;
    --my: 0%;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(255 255 255 / 0.03);
    padding: 1.25rem;
    transition: transform 0.25s ease, border-color 0.3s ease, background 0.3s ease;
  }
  .value-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(380px circle at var(--mx) var(--my), rgb(34 211 238 / 0.2), transparent 45%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .value-card:hover {
    border-color: rgb(103 232 249 / 0.45);
    background: rgb(255 255 255 / 0.05);
  }
  .value-card:hover::before { opacity: 1; }
  .value-card.tracking { transition: border-color 0.3s ease, background 0.3s ease; }

  .value-visual {
    display: flex;
    height: 11rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.9rem;
    background: rgb(0 0 0 / 0.35);
    border: 1px solid rgb(255 255 255 / 0.06);
    padding: 1rem;
  }
  .value-title { font-size: 1.125rem; font-weight: 600; color: rgb(165 243 252); }
  .value-text { font-size: 0.875rem; line-height: 1.6; color: rgb(209 213 219); }

  /* 1. Capas */
  .layers { flex-direction: column; gap: 0.4rem; }
  .layer {
    display: flex;
    width: 100%;
    max-width: 15rem;
    align-items: center;
    justify-content: space-between;
    border-radius: 0.6rem;
    border: 1px solid;
    padding: 0.4rem 0.75rem;
    animation: layer-float 4s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.7s);
    transition: transform 0.4s ease;
  }
  .layer-cyan    { color: rgb(165 243 252); background: rgb(34 211 238 / 0.12); border-color: rgb(34 211 238 / 0.4); }
  .layer-indigo  { color: rgb(199 210 254); background: rgb(99 102 241 / 0.15); border-color: rgb(129 140 248 / 0.45); }
  .layer-emerald { color: rgb(167 243 208); background: rgb(16 185 129 / 0.12); border-color: rgb(52 211 153 / 0.4); }
  .value-card:hover .layer { transform: translateX(calc((var(--i) - 1) * 10px)) scale(1.03); }
  @keyframes layer-float {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 -3px; }
  }

  /* 2. Flujo de pago */
  .flow { position: relative; justify-content: space-between; gap: 0.5rem; }
  .flow-line {
    position: absolute;
    left: 14%;
    right: 14%;
    top: 40%;
    height: 2px;
    background: rgb(255 255 255 / 0.12);
  }
  /* El recorrido usa transform: el punto viaja dentro de una pista que lo recorta en los extremos */
  .flow-track {
    position: absolute;
    top: -3px;
    left: 0;
    width: 100%;
    height: 8px;
    overflow: hidden;
  }
  .flow-slide {
    position: relative;
    width: 100%;
    height: 8px;
    animation: flow-travel 3.9s ease-in-out infinite;
  }
  .flow-dot {
    position: absolute;
    top: 0;
    right: 0;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(103 232 249);
    box-shadow: 0 0 12px 2px rgb(34 211 238 / 0.8);
  }
  .flow-node {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    color: rgb(156 163 175);
  }
  .flow-node svg {
    box-sizing: content-box;
    padding: 0.6rem;
    border-radius: 0.8rem;
    background: rgb(23 23 28);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  /* Anillo cian que se enciende cuando el pulso pasa por el nodo */
  .flow-node::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 45px;
    height: 45px;
    transform: translateX(-50%);
    border-radius: 0.8rem;
    border: 1px solid rgb(103 232 249);
    box-shadow: 0 0 14px rgb(34 211 238 / 0.45);
    opacity: 0;
    animation: node-ring 3.9s ease-in-out infinite;
    animation-delay: var(--d);
  }
  @keyframes flow-travel {
    0%   { transform: translateX(-100%); opacity: 0; }
    8%   { opacity: 1; }
    92%  { opacity: 1; }
    100% { transform: translateX(0); opacity: 0; }
  }
  @keyframes node-ring {
    0%, 100% { opacity: 0; }
    8%, 30%  { opacity: 1; }
  }
  .value-card:hover .flow-slide { animation-duration: 2s; }

  /* 3. Comprobaciones de seguridad */
  .vault { flex-direction: column; align-items: stretch; justify-content: center; gap: 0.45rem; }
  .vault-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px dashed rgb(255 255 255 / 0.12);
  }
  .vault-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.04);
    padding: 0.3rem 0.6rem;
    color: rgb(229 231 235);
    animation: row-in 5s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.5s);
  }
  .vault-check { color: rgb(52 211 153); }
  @keyframes row-in {
    0%, 6%   { opacity: 0.25; transform: translateX(-8px); }
    14%, 82% { opacity: 1;    transform: translateX(0); }
    94%, 100% { opacity: 0.25; transform: translateX(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer, .flow-slide, .flow-node::before, .vault-row { animation: none; }
    .flow-slide { display: none; }
    .value-card, .layer { transition: none; }
  }
</style>
