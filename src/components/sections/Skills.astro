---
import { tags, skillsMain, skillsKnowledge } from '../../data/tags.astro'
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const main = skillsMain.map((key) => tags[key])
const groups = skillsKnowledge.map(({ key, items }) => ({
  title: t(key),
  technologies: items.map((item) => tags[item]),
}))
---

<section class="py-5">
  <!-- Stack principal: tarjetas destacadas -->
  <h3 class="mb-4 text-sm font-medium uppercase tracking-wider text-cyan-300">{t('skills.main')}</h3>
  <ul class="grid grid-cols-2 sm:grid-cols-3 gap-4">
    {main.map(tech => (
      <li class="group flex items-center gap-x-3 md:gap-x-4 rounded-2xl border border-cyan-900/60 bg-white/5 p-3 md:p-4 transition duration-300 hover:-translate-y-0.5 hover:border-cyan-300/40">
        <tech.icon class="size-8 md:size-12 shrink-0" />
        <span class="min-w-0 text-sm md:text-base font-medium text-white">{tech.name}</span>
      </li>
    ))}
  </ul>

  <!-- Conocimientos: agrupados por área, con menos peso visual -->
  <h3 class="mt-10 mb-4 text-sm font-medium uppercase tracking-wider text-cyan-300">{t('skills.knowledge')}</h3>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {groups.map(({ title, technologies }) => (
      <div>
        <h4 class="mb-2 text-sm font-semibold text-gray-300">{title}</h4>
        <ul class="flex flex-wrap gap-2">
          {technologies.map(tech => (
            <li class="inline-flex items-center gap-x-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm text-gray-300">
              <tech.icon class="size-5 shrink-0" />
              {tech.name}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
