---
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import { tags } from '../../data/tags.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Hoja de ruta de JOEY: los dos primeros pasos se están construyendo; la tienda web viene después.
// Cada paso lista el stack con el que se construye (claves de data/tags.astro).
const steps = [
  { label: t('joey.step1'), building: true, stack: ['NestJS', 'Prisma', 'PostgreSQL'] },
  { label: t('joey.step2'), building: true, stack: ['React', 'TAILWIND'] },
  { label: t('joey.step3'), building: false, stack: ['NextJS'] },
];
---

<article data-pause-offscreen class="rounded-xl border border-dashed border-cyan-300/30 bg-white/[0.03] p-5 md:p-7">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <h3 class="text-2xl font-semibold text-cyan-200">JOEY</h3>
    <span class="inline-flex items-center gap-x-2 rounded-full border border-cyan-300/30 bg-cyan-300/10 px-3 py-0.5 text-xs font-medium text-cyan-200">
      <span class="relative flex size-2" aria-hidden="true">
        <span class="joey-ping absolute inline-flex size-full rounded-full bg-cyan-300 opacity-75"></span>
        <span class="relative inline-flex size-2 rounded-full bg-cyan-300"></span>
      </span>
      {t('joey.badge')}
    </span>
  </div>

  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-gray-300 md:text-base">{t('joey.text')}</p>

  <ol class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-3">
    {steps.map(({ label, building, stack }, i) => (
      <li class:list={[
        'relative rounded-lg border px-4 py-3',
        building ? 'border-cyan-300/30 bg-cyan-300/[0.06]' : 'border-dashed border-white/15 bg-transparent',
      ]}>
        <div class="flex items-center justify-between gap-3">
          <span class:list={['text-sm font-medium', building ? 'text-white' : 'text-gray-400']}>{label}</span>
          <span class:list={['shrink-0 text-xs', building ? 'text-cyan-300' : 'text-gray-500']}>
            {building ? t('joey.building') : t('joey.next')}
          </span>
        </div>
        <!-- Barra de avance: las etapas en desarrollo muestran un tramo animado, la siguiente queda vacía -->
        <div class="mt-3 h-1 overflow-hidden rounded-full bg-white/10" aria-hidden="true">
          {building && <div class="joey-bar h-full rounded-full bg-cyan-300/80" style={`--i:${i}`}></div>}
        </div>
        <ul class="mt-3 flex flex-wrap gap-2" aria-label="Stack">
          {stack.map((key) => (
            <li class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-xs text-gray-300">{tags[key].name}</li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</article>

<style>
  .joey-ping {
    animation: joey-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes joey-ping {
    75%, 100% { transform: scale(2.4); opacity: 0; }
  }

  .joey-bar {
    width: 40%;
    animation: joey-slide 2.6s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.4s);
  }
  @keyframes joey-slide {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(250%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .joey-ping, .joey-bar { animation: none; }
    .joey-bar { width: 40%; }
  }
</style>
