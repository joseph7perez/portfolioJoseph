---
import { getCollection } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectInProgress from './ProjectInProgress.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Misma colección que el inicio, sin filtrar por showOnHome: aquí están todos los proyectos terminados.
const projects = (await getCollection('projects')).map(({ data }) => data);

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---

<ProjectLayout title={t('projects.page.metaTitle')} description={t('projects.page.description')}>
  <section class="w-full max-w-6xl mx-auto py-10 mt-20">
    <h1 class="text-white text-3xl md:text-4xl font-bold mb-3">{t('projects.page.title')}</h1>
    <p class="mb-10 text-base md:text-lg leading-relaxed text-gray-400 text-pretty">{t('projects.page.description')}</p>

    <div class="flex flex-col gap-6">
      {featured.length > 0 && (
        <section aria-labelledby="projects-featured">
          <h2 id="projects-featured" class="sr-only">{t('projects.featured')}</h2>
          {featured.map((project) => (
            <ProjectCard project={project} featured />
          ))}
        </section>
      )}

      <section aria-labelledby="projects-all" class="mt-4">
        <h2 id="projects-all" class="mb-5 text-xl font-semibold text-white">{t('projects.more')}</h2>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>

      <section aria-labelledby="projects-in-progress" class="mt-4">
        <h2 id="projects-in-progress" class="mb-5 text-xl font-semibold text-white">{t('projects.inProgress')}</h2>
        <ProjectInProgress />
      </section>
    </div>
  </section>
</ProjectLayout>
