---
const { tags } = Astro.props;
---

<ul class="gap-x-4 gap-y-5 mb-8 grid grid-cols-4 md:grid-cols-6 lg:grid-cols-7 justify-around">
    {tags.map((tag: { icon: any; color: string; name: string; }) => (
        <li class="flex flex-col items-center gap-y-2 text-center">
            <tag.icon class="size-8 md:size-10"></tag.icon>
            <span class="text-xs md:text-sm text-gray-300 font-light">{tag.name}</span>
        </li>
    ))}
</ul>
