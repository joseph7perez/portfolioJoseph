---
import Layout from '../../layouts/Layout.astro';
import Linkedin from '../../icons/social/Linkedin.astro';
import Github from '../../icons/social/Github.astro';
import Instagram from '../../icons/social/Instagram.astro';
import Email from '../../icons/social/Email.astro';
import SocialPill from '../../components/ui/SocialPill.astro';
import Experience from '../../components/sections/Experience.astro';
import SectionContainer from '../../components/layout/SectionContainer.astro';
import Projects from '../../components/sections/Projects.astro';
import SobreMi from '../../components/sections/SobreMi.astro';
import Educacion from '../../components/sections/Educacion.astro';
import Briefcase from '../../icons/ui/Briefcase.astro';
import CodeBranch from '../../icons/ui/CodeBranch.astro';
import UserSuit from '../../icons/ui/UserSuit.astro';
import UserGraduate from '../../icons/ui/UserGraduate.astro';
import File from '../../icons/ui/File.astro';
import Skills from '../../components/sections/Skills.astro';
import Code from '../../icons/ui/Code.astro';
import NavMobile from '../../components/layout/NavMobile.astro';
import Aporte from '../../components/sections/Aporte.astro';
import Contacto from '../../components/sections/Contacto.astro';
import DotField from '../../components/ui/DotField.astro';

import { getLangFromUrl, useTranslations } from '../../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t('meta.title')} description={t('meta.description')}>
	<main>
		<SectionContainer id="top" class="relative isolate min-h-screen flex flex-col items-center justify-center text-center pt-24 pb-10" data-pause-offscreen>
			<DotField host="top" intro="load" class="inset-y-0 left-1/2 w-screen -translate-x-1/2" />
			<p class="hero-in text-white text-xl md:text-2xl font-medium pb-3" style="--d:0">{t('hero.greeting')}</p>
			<h1 style="--d:1" class="hero-in text-white text-3xl md:text-4xl lg:text-5xl font-bold text-balance max-w-[820px] pb-5 lg:pb-6">{t('hero.title')}</h1>
			<p class="hero-in text-white/80 text-sm lg:text-xl text-pretty max-w-[700px]" style="--d:2">{t('hero.subtitle')}</p>
			<p style="--d:3" class="hero-in mt-5 inline-flex flex-wrap items-center justify-center gap-x-3 gap-y-1 rounded-full border border-cyan-300/30 bg-cyan-300/10 px-4 py-1.5 text-xs md:text-sm text-cyan-100">
				<span class="inline-flex items-center gap-x-2">
					<span class="relative flex size-2" aria-hidden="true">
						<span class="status-ping absolute inline-flex size-full rounded-full bg-cyan-300 opacity-75"></span>
						<span class="relative inline-flex size-2 rounded-full bg-cyan-300"></span>
					</span>
					{t('hero.badge')}
				</span>
				<span class="text-cyan-100/70">{t('hero.ai')}</span>
			</p>
			<nav style="--d:4" class="hero-in flex gap-5 justify-center mt-5">
				<div class="group flex flex-col items-center w-12">
					<SocialPill href="https://github.com/joseph7perez" aria-label="GitHub">
						<Github class="size-5 lg:size-6 text-white" aria-hidden="true"/>
					</SocialPill>
					<span class="mt-2 text-xs md:text-sm text-cyan-200 opacity-0 group-hover:opacity-100 transition-opacity duration-300">GitHub</span>
				</div>
				
				<div class="group flex flex-col items-center w-12">
					<SocialPill href="https://www.linkedin.com/in/joseph-nicolas-p%C3%A9rez-sarmiento-250898244/" aria-label="LinkedIn">
						<Linkedin class="size-5 lg:size-6 text-white" aria-hidden="true"/>
					</SocialPill>
					<span class="mt-2 text-xs md:text-sm text-cyan-200 opacity-0 group-hover:opacity-100 transition-opacity duration-300">LinkedIn</span>
				</div>

				<div class="group flex flex-col items-center w-12">
					<SocialPill href="https://www.instagram.com/joseph_perez7/" aria-label="Instagram">
						<Instagram class="size-5 lg:size-6 text-white" aria-hidden="true"/>
					</SocialPill>
					<span class="mt-2 text-xs md:text-sm text-cyan-200 opacity-0 group-hover:opacity-100 transition-opacity duration-300">Instagram</span>
				</div>

				<div class="group flex flex-col items-center w-12">
					<SocialPill href="mailto:josephperezsarmiento@hotmail.com" aria-label="Email">
						<Email class="size-5 lg:size-6 text-white" aria-hidden="true"/>
					</SocialPill>
					<span class="mt-2 text-xs md:text-sm text-cyan-200 opacity-0 group-hover:opacity-100 transition-opacity duration-300">Email</span>

				</div>
			</nav>

			<div style="--d:5" class="hero-in mt-6 flex flex-wrap justify-center gap-3">
				<a href="#projects" class="inline-flex items-center bg-cyan-400 hover:bg-cyan-300 text-neutral-950 font-semibold px-6 py-3 rounded-full transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">
					{t('hero.cta')}
				</a>
				<a href="#contact" class="inline-flex items-center border border-cyan-300/50 hover:bg-cyan-300/10 text-cyan-100 font-medium px-6 py-3 rounded-full transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">
					{t('hero.contact')}
				</a>
				<a href={t('cv.href')} download={t('cv.filename')} class="inline-flex items-center gap-x-2 text-white/80 hover:text-white hover:bg-white/10 px-5 py-3 rounded-full transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">
					<File class="size-5" aria-hidden="true"/>
					{t('hero.cv')}
				</a>
			</div>
		</SectionContainer>

		<SectionContainer id="aporte" class="mb-24 reveal">
			<Aporte></Aporte>
		</SectionContainer>

		<SectionContainer id="projects" class="scroll-mt-30 mb-24 reveal" >
			<h2 class="text-white text-3xl font-semibold mb-6 flex gap-x-3 items-center" >
				<CodeBranch class="size-6"></CodeBranch>
				{t('section.projects')}
			</h2>
			<Projects></Projects>
		</SectionContainer>

		<SectionContainer id="experience" class="scroll-mt-24 mb-24 reveal">
			<h2 class="text-white text-3xl font-semibold mb-3 flex gap-x-3 items-center" >
				<Briefcase class="size-6"></Briefcase>
				{t('section.experience')}
			</h2>
			<Experience></Experience>
		</SectionContainer>

		<SectionContainer id="skills" class="scroll-mt-24 mb-24 reveal">
			<h2 class="text-white text-3xl font-bold mb-3 flex gap-x-3 items-center " >
				<Code class="size-7"></Code>
				{t('section.skills')}
			</h2>
			<Skills></Skills>

		</SectionContainer>

		<SectionContainer id="sobre" class="scroll-mt-34  mb-24 reveal">
			<h2 class="text-white text-3xl font-semibold mb-3 flex gap-x-3 items-center" >
				<UserSuit class="size-6"></UserSuit>
				{t('section.about')}
			</h2>
			<SobreMi></SobreMi>
		</SectionContainer>

		<SectionContainer id="educacion" class="scroll-mt-24 mb-24 reveal">
			<h2 class="text-white text-3xl font-bold mb-3 flex gap-x-3 items-center " >
				<UserGraduate class="size-6"></UserGraduate>
				{t('section.education')}
			</h2>
			<Educacion></Educacion>
		</SectionContainer>

		<SectionContainer id="contact" class="scroll-mt-24 mb-24 reveal">
			<Contacto></Contacto>
		</SectionContainer>

		<NavMobile></NavMobile>
	</main>
</Layout>

<!-- Pausa las animaciones infinitas de los bloques que no se ven -->
<script is:inline>
  (function () {
    var blocks = document.querySelectorAll('[data-pause-offscreen]');
    if ('IntersectionObserver' in window) {
      var watcher = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) entry.target.removeAttribute('data-offscreen');
          else entry.target.setAttribute('data-offscreen', '');
        });
      });
      blocks.forEach(function (el) { watcher.observe(el); });
    }
  })();
</script>

<!-- Scroll-spy: marca como activo el enlace de la sección que cruza el centro de la pantalla -->
<script is:inline>
  (function () {
    var links = document.querySelectorAll('a[data-nav]');
    var sections = [];
    links.forEach(function (link) {
      var el = document.getElementById(link.getAttribute('data-nav').slice(1));
      if (el && sections.indexOf(el) === -1) sections.push(el);
    });
    if (!('IntersectionObserver' in window) || !sections.length) return;

    var alias = { aporte: 'top' }; // "Qué puedo aportar" no tiene enlace propio: cuenta como Inicio
    var setActive = function (id) {
      id = alias[id] || id;
      links.forEach(function (link) {
        if (link.getAttribute('data-nav') === '#' + id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    var spy = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    }, { rootMargin: '-40% 0px -55% 0px' });

    sections.concat([document.getElementById('aporte')]).forEach(function (el) { if (el) spy.observe(el); });
  })();
</script>

<!-- Aparición de cada sección al entrar en pantalla (estilos en el bloque <style> de abajo) -->
<script is:inline>
  (function () {
    var sections = document.querySelectorAll('.reveal');
    var show = function (el) { el.classList.add('is-visible'); };

    if (!('IntersectionObserver' in window)) {
      sections.forEach(show);
      return;
    }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          show(entry.target);
          observer.unobserve(entry.target); // solo una vez
        }
      });
    }, { threshold: 0.1 });

    sections.forEach(function (el) { observer.observe(el); });

    // Al saltar a una sección por ancla, se muestra al instante en vez de dejar un hueco en blanco
    document.addEventListener('click', function (e) {
      var link = e.target.closest && e.target.closest('a[href*="#"]');
      if (!link) return;
      var target = document.getElementById(link.hash.slice(1));
      if (target && target.classList.contains('reveal')) {
        target.classList.add('is-instant', 'is-visible');
      }
    });
  })();
</script>

<style is:global>
  /* Entrada del hero: una sola secuencia al cargar, escalonada */
  .hero-in {
    animation: hero-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--d, 0) * 90ms);
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  /* Las animaciones en bucle se pausan cuando su bloque sale de pantalla */
  [data-offscreen], [data-offscreen] *, [data-offscreen] *::before, [data-offscreen] *::after {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in { animation: none; }
  }
  .status-ping { animation: status-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite; }
  @keyframes status-ping { 75%, 100% { transform: scale(2.4); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .status-ping { animation: none; } }

  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  .reveal.is-instant {
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
