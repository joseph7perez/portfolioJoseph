---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import { navItems } from '../../i18n/nav';
import LangToggle from '../ui/LangToggle.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Base del home en el idioma actual ('/' o '/en/'), para que los anclas funcionen también desde las páginas de detalle de proyecto.
const home = getRelativeLocaleUrl(lang, '/');
---

<script>
  //Colocar el header con fondo oscuro al hacer scroll
  if (typeof window !== "undefined") {
    window.addEventListener("scroll", () => {
      const header = document.querySelector("header");
      if (window.scrollY > 10) {
        header?.classList.add("bg-neutral-950/30", "backdrop-blur-md", "shadow-md");
      } else {
        header?.classList.remove("bg-neutral-950/30", "backdrop-blur-md", "shadow-md");
      }
    });
  }
</script>

<!-- En desktop son tres columnas (1fr auto 1fr): el menú queda centrado en pantalla aunque los lados midan distinto -->
<header class="w-full px-4 md:px-[max(1rem,calc((100%-72rem)/2))] py-5 flex justify-between md:grid md:grid-cols-[1fr_auto_1fr] items-center mx-auto fixed top-0 z-50 transition-all duration-300">
  <!-- Foto de perfil -->
  <a href={home} class="md:justify-self-start">
    <img
      loading="lazy"
      class="rounded-full size-12"
      src="/fotoPerfil.avif"
      alt={t('header.photoAlt')}
    />
  </a>

  <!-- Menú desktop -->
  <nav class="hidden md:flex flex-row gap-x-10 opacity-80 text-sm">
    {navItems.filter(item => item.hash !== '#contact').map(item => (
      <a
        href={`${home}${item.hash}`}
        data-nav={item.hash}
        class="inline-flex min-h-11 items-center text-white hover:underline underline-offset-4 aria-[current=true]:text-cyan-300 aria-[current=true]:underline"
      >{t(item.key)}</a>
    ))}
  </nav>

  <div class="flex items-center gap-3 md:justify-self-end">
    <a
      href={`${home}#contact`}
      data-nav="#contact"
      class="hidden md:inline-flex min-h-11 items-center rounded-full bg-cyan-400 px-5 text-sm font-semibold text-neutral-950 transition hover:bg-cyan-300 aria-[current=true]:ring-2 aria-[current=true]:ring-cyan-200/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
    >{t('nav.contact')}</a>
    <LangToggle />
  </div>
</header>